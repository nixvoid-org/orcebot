---
import Scene from '../components/Scene.tsx';

const title = 'OrceBot — a tiny robot drifting through space | nixvoid';
const description =
	'Meet OrceBot: a small machine adrift in the cold dark of space. Watch the interactive 3D companion float silently among the stars — a calm, distraction-free landing experience from nixvoid.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og-image.svg', Astro.site).toString();

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'OrceBot',
	url: Astro.site?.toString() ?? canonical,
	description,
	publisher: {
		'@type': 'Organization',
		name: 'nixvoid',
		url: 'https://github.com/nixvoid-org',
	},
};

const orgSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'nixvoid',
	url: 'https://github.com/nixvoid-org',
	logo: ogImage,
	sameAs: ['https://github.com/nixvoid-org'],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="theme-color" content="#05030f" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="nixvoid" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="OrceBot drifting through space, on a starfield background" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="OrceBot drifting through space, on a starfield background" />

		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
	</head>
	<body>
		<main class="stage">
			<h2 class="visually-hidden">An interactive 3D companion floating in space</h2>

			<div class="scene">
				<Scene client:only="react" />
			</div>

			<div class="vignette" aria-hidden="true"></div>

			<header class="topbar">
				<span class="brand">Orcebot returns</span>
			</header>

			<footer class="footer">
				<span>
					© {new Date().getFullYear()}{' '}
					<a
						class="footer-link"
						href="https://nixvoid.com"
						target="_blank"
						rel="noopener noreferrer"
					>
						Nixvoid
					</a>
				</span>
			</footer>
		</main>

		<style is:global>
			:root {
				color-scheme: dark;
				--bg: #05030f;
				--fg: #e7e9ff;
				--muted: #8a8fb8;
				--accent: #a78bfa;
				--accent-2: #22d3ee;
				--yellow: #facc15;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				background: var(--bg);
				color: var(--fg);
				font-family:
					'Inter',
					system-ui,
					-apple-system,
					'Segoe UI',
					Roboto,
					sans-serif;
				overflow: hidden;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			.stage {
				position: relative;
				width: 100vw;
				height: 100vh;
				overflow: hidden;
			}

			.visually-hidden {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			.scene {
				position: absolute;
				inset: 0;
				z-index: 0;
			}

			.scene :global(canvas) {
				display: block;
				width: 100% !important;
				height: 100% !important;
			}

			.vignette {
				position: absolute;
				inset: 0;
				z-index: 1;
				pointer-events: none;
				background:
					radial-gradient(
						ellipse at 50% 40%,
						transparent 0%,
						transparent 45%,
						rgba(5, 3, 15, 0.6) 80%,
						rgba(5, 3, 15, 0.95) 100%
					),
					linear-gradient(
						180deg,
						rgba(5, 3, 15, 0.55) 0%,
						transparent 25%,
						transparent 75%,
						rgba(5, 3, 15, 0.7) 100%
					);
			}

			.topbar {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				z-index: 3;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1.4rem 2.2rem;
				font-size: 0.9rem;
				letter-spacing: 0.04em;
			}

			.brand {
				font-weight: 700;
				font-size: 1.1rem;
				letter-spacing: 0.02em;
				color: var(--yellow);
				text-shadow: 0 0 18px rgba(250, 204, 21, 0.35);
			}

			.footer {
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				z-index: 3;
				display: flex;
				justify-content: center;
				padding: 1.2rem 2.2rem;
				font-size: 0.78rem;
				color: var(--muted);
				letter-spacing: 0.06em;
			}

			.footer-link {
				color: var(--fg);
				border-bottom: 1px solid rgba(231, 233, 255, 0.25);
				transition: border-color 0.2s ease;
			}

			.footer-link:hover {
				border-bottom-color: var(--fg);
			}

			@media (max-width: 640px) {
				.topbar {
					padding: 1rem 1.2rem;
				}
				.footer {
					padding: 1rem 1.2rem;
				}
			}
		</style>
	</body>
</html>
