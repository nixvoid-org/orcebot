---
import Scene from '../components/Scene.tsx';

const title = 'OrceBot — a tiny robot drifting through space | nixvoid';
const description =
	'Meet OrceBot: a small machine adrift in the cold dark of space. Watch the interactive 3D companion float silently among the stars — a calm, distraction-free landing experience from nixvoid.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og-image.svg', Astro.site).toString();
const repoUrl = 'https://github.com/nixvoid-org/orcebot';

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'OrceBot',
	url: Astro.site?.toString() ?? canonical,
	description,
	publisher: {
		'@type': 'Organization',
		name: 'nixvoid',
		url: 'https://github.com/nixvoid-org',
	},
};

const orgSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'nixvoid',
	url: 'https://github.com/nixvoid-org',
	logo: ogImage,
	sameAs: ['https://github.com/nixvoid-org'],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="theme-color" content="#05030f" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="nixvoid" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="OrceBot drifting through space, on a starfield background" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="OrceBot drifting through space, on a starfield background" />

		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
	</head>
	<body>
		<main class="stage">
			<h2 class="visually-hidden">An interactive 3D companion floating in space</h2>

			<div class="scene">
				<Scene client:only="react" />
			</div>

			<div class="vignette" aria-hidden="true"></div>

			<header class="topbar">
				<span class="brand">
					<span class="brand-dot"></span>
					orcebot
				</span>
				<nav class="nav">
					<a href={repoUrl} target="_blank" rel="noopener noreferrer">
						source on github
					</a>
				</nav>
			</header>

			<section class="hero">
				<p class="eyebrow">Adrift in the void</p>
				<h1>
					OrceBot
					<span class="hero-accent">drifts through space</span>
				</h1>
				<p class="lede">
					A small machine, a large silence. Watch it float — gently spinning,
					untethered, somewhere between here and the stars.
				</p>
				<div class="cta">
					<a
						class="btn btn-primary"
						href={repoUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						View the source
					</a>
				</div>
			</section>

			<footer class="footer">
				<span>© {new Date().getFullYear()} nixvoid</span>
				<span class="status">
					<span class="status-dot"></span> live signal
				</span>
			</footer>
		</main>

		<style is:global>
			:root {
				color-scheme: dark;
				--bg: #05030f;
				--fg: #e7e9ff;
				--muted: #8a8fb8;
				--accent: #a78bfa;
				--accent-2: #22d3ee;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				background: var(--bg);
				color: var(--fg);
				font-family:
					'Inter',
					system-ui,
					-apple-system,
					'Segoe UI',
					Roboto,
					sans-serif;
				overflow: hidden;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			.stage {
				position: relative;
				width: 100vw;
				height: 100vh;
				overflow: hidden;
			}

			.visually-hidden {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			.scene {
				position: absolute;
				inset: 0;
				z-index: 0;
			}

			.scene :global(canvas) {
				display: block;
				width: 100% !important;
				height: 100% !important;
			}

			.vignette {
				position: absolute;
				inset: 0;
				z-index: 1;
				pointer-events: none;
				background:
					radial-gradient(
						ellipse at 50% 40%,
						transparent 0%,
						transparent 45%,
						rgba(5, 3, 15, 0.6) 80%,
						rgba(5, 3, 15, 0.95) 100%
					),
					linear-gradient(
						180deg,
						rgba(5, 3, 15, 0.55) 0%,
						transparent 25%,
						transparent 75%,
						rgba(5, 3, 15, 0.7) 100%
					);
			}

			.topbar {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				z-index: 3;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1.4rem 2.2rem;
				font-size: 0.9rem;
				letter-spacing: 0.04em;
			}

			.brand {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				font-weight: 600;
				text-transform: lowercase;
			}

			.brand-dot {
				width: 8px;
				height: 8px;
				border-radius: 999px;
				background: var(--accent);
				box-shadow: 0 0 14px var(--accent);
			}

			.nav {
				display: flex;
				gap: 1.6rem;
				color: var(--muted);
			}

			.nav a {
				transition: color 0.2s ease;
			}

			.nav a:hover {
				color: var(--fg);
			}

			.hero {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 12%;
				z-index: 2;
				padding: 0 2.2rem;
				max-width: 720px;
				margin-left: clamp(1rem, 6vw, 5rem);
				pointer-events: none;
			}

			.hero .cta,
			.hero a {
				pointer-events: auto;
			}

			.eyebrow {
				margin: 0 0 0.6rem;
				font-size: 0.78rem;
				letter-spacing: 0.32em;
				text-transform: uppercase;
				color: var(--accent);
			}

			.hero h1 {
				margin: 0 0 1rem;
				font-size: clamp(2.4rem, 6vw, 4.6rem);
				line-height: 1.02;
				font-weight: 700;
				letter-spacing: -0.02em;
			}

			.hero-accent {
				display: block;
				background: linear-gradient(
					90deg,
					var(--accent) 0%,
					var(--accent-2) 100%
				);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.lede {
				margin: 0 0 1.6rem;
				max-width: 36rem;
				color: var(--muted);
				font-size: clamp(0.95rem, 1.3vw, 1.05rem);
				line-height: 1.6;
			}

			.cta {
				display: flex;
				gap: 0.8rem;
				flex-wrap: wrap;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.75rem 1.2rem;
				border-radius: 999px;
				font-size: 0.92rem;
				font-weight: 500;
				border: 1px solid transparent;
				transition:
					transform 0.2s ease,
					background 0.2s ease,
					border-color 0.2s ease;
			}

			.btn-primary {
				background: linear-gradient(
					90deg,
					var(--accent) 0%,
					var(--accent-2) 100%
				);
				color: #0b0820;
			}

			.btn-primary:hover {
				transform: translateY(-1px);
			}

			.btn-ghost {
				border-color: rgba(231, 233, 255, 0.18);
				color: var(--fg);
			}

			.btn-ghost:hover {
				border-color: rgba(231, 233, 255, 0.4);
				background: rgba(231, 233, 255, 0.04);
			}

			.footer {
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				z-index: 3;
				display: flex;
				justify-content: space-between;
				padding: 1.2rem 2.2rem;
				font-size: 0.78rem;
				color: var(--muted);
				letter-spacing: 0.06em;
			}

			.status {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
			}

			.status-dot {
				width: 6px;
				height: 6px;
				border-radius: 999px;
				background: #22d3ee;
				box-shadow: 0 0 10px #22d3ee;
				animation: pulse 1.8s ease-in-out infinite;
			}

			@keyframes pulse {
				0%,
				100% {
					opacity: 1;
				}
				50% {
					opacity: 0.35;
				}
			}

			@media (max-width: 640px) {
				.topbar {
					padding: 1rem 1.2rem;
				}
				.nav {
					gap: 1rem;
				}
				.hero {
					bottom: 9%;
					padding: 0 1.2rem;
					margin-left: 0;
				}
				.footer {
					padding: 1rem 1.2rem;
				}
			}
		</style>
	</body>
</html>
